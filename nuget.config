<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- All packages come from nuget.org; feeds from the user's or machine's NuGet configuration are not used. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
